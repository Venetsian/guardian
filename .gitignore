# WP-Guardian .gitignore
# Secrets & runtime data — NEVER commit these
wp-guardian.conf
whitelist.conf
tripwires.txt
logfiles.txt
CLAUDE.md

# Runtime state
state/
logs/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
*.swp
*~
Thumbs.db

# Editor/IDE
.claude/*
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Backups
*.bak
*.orig

# Internal working docs — incident reports and implementation specs.
# These carry real customer data and production firewall config.
# Kept locally, never published (this repo is public).
guardian-fp-report.md
wp-guardian-v1.4-spec.md

# Local PII-checker exemptions — site-specific, never published.
.pii-allowlist

# PII checker — kept local, not published.
tools/check-pii.sh
