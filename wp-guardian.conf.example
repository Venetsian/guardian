[general]
# WP-Guardian Configuration
# Copy this file to wp-guardian.conf and edit as needed.
# IMPORTANT: wp-guardian.conf contains API tokens — keep chmod 600!

# Run in dry-run mode (log actions but don't actually block)
dry_run = false

# Main log level: DEBUG, INFO, WARNING, ERROR
log_level = INFO

# Path to logfiles list (one access log path per line)
# Use --discover-logs-save to auto-populate this file
logfiles_list = /opt/wp-guardian/logfiles.txt

# How often to run periodic tasks (cleanup, summary) in seconds
periodic_interval = 60

[thresholds]
# Detection thresholds — hits within time_window triggers a block
# Set to 0 to disable a specific check

time_window = 300

# Web module
wp_login_threshold = 10
xmlrpc_threshold = 5
author_enum_threshold = 8
php_404_threshold = 20
general_404_threshold = 50

# --- 404-storm shaping (v1.7.16+) -------------------------------------------
# The count above answers "how many misses?". On a host serving a React /
# Next.js / Nuxt / SvelteKit front end that question alone gets the answer
# wrong, because two very different clients produce the same number.
#
# A single-page app prefetches one payload per route it might navigate to.
# The moment a deploy makes the build on disk disagree with the route manifest
# in an already-loaded browser tab, every one of those prefetches misses at
# once. Measured on a production Next.js host: 134 misses in one minute from a
# developer's own browser against a threshold of 50 per 300s, alongside 100
# successful requests in the same window. Six blocks over four months, one
# escalated to a 30-day tier 2.
#
# Two knobs separate that from a scanner.

# 1. Framework navigation payloads (?_rsc=, /_next/, __next.*.txt, /_nuxt/,
#    __data.json, ...) are counted in their own bucket at this much looser
#    threshold. They are generated URLs, not path enumeration. A .php path is
#    NEVER classified this way, so no tripwire, webshell or PHP-scan rule can
#    be reached through it, and a route-shaped path is required, so
#    /backup.zip?_rsc=1 and /.env?_rsc=1 stay ordinary enumeration.
#    Set equal to general_404_threshold to disable the distinction.
framework_404_threshold = 400

# 2. A storm is a ratio, not a count. Before blocking, require misses to be
#    at least this share of everything the client was served in the window.
#    A browser rendering a site pulls real content alongside its misses; a
#    scanner enumerating one pulls almost nothing that exists. Fleet data:
#    developers mid-rebuild sit at 0.59-0.60, real scanners at 0.98-1.00.
#    Set to 0 to restore the old count-only behaviour.
general_404_min_fail_ratio = 0.9

# Ceiling on the ratio guard: past this many misses in the window, block
# whatever the ratio says. Stops a high-volume scanner from buying immunity
# by padding its run with requests for pages that exist.
general_404_hard_limit = 500

# Suspicious PHP scanning — random/gibberish .php filenames (v1.7.10+)
# How many pattern hits within time_window before blocking.
suspicious_threshold = 3
# Which response statuses count as scanning evidence.
#   404 = "no such file"          — the classic enumeration signature
#   403 = "forbidden"             — deny-heavy installs (Apache/nginx `deny`,
#                                   ModSecurity, CyberPanel) answer scans with
#                                   403 instead of 404. On one Apache host in
#                                   our fleet 403 outnumbers 404 on these paths
#                                   by ~100:1, so dropping it removes almost
#                                   all detections.
#   401 = "auth required"         — server-level auth challenge on a probed path
#
# NARROW THIS TO '404' if the host serves a customer-facing PHP endpoint whose
# name is 6+ lowercase letters (/billing.php, /account.php) and which returns
# application-level 403s to logged-in users. Also add that endpoint to
# [whitelist] legit_php_paths. Authenticated IPs are already exempt from this
# rule, so this is a second line of defense for pre-login 403s.
suspicious_statuses = 404, 401, 403

# Login isolation — bots that ONLY hit wp-login.php without loading CSS
# Threshold: how many wp-login.php requests with zero CSS loads = block
login_isolation_threshold = 3
# Detection window in seconds (how long to wait for a CSS load before deciding)
login_isolation_window = 120
# How long to keep tracking data (hours) — longer = better escalation for repeat offenders
login_isolation_retention_hours = 48

# SMTP module
# Mail clients (Outlook, Apple Mail, Thunderbird) retry aggressively after a
# misconfiguration, so thresholds are looser than SSH. An IP that has
# successfully logged in on ANY protocol within [auth_tracking] mail_trust_duration
# is exempt from these thresholds (see [auth_tracking] below).
smtp_auth_fail_threshold = 10
smtp_nonexistent_user_threshold = 3

# IMAP/POP3 module
imap_auth_fail_threshold = 10
imap_nonexistent_user_threshold = 3

# SSH module (most aggressive)
ssh_fail_threshold = 3
ssh_invalid_user_instant_block = true

# Root SSH attempts are higher signal than ordinary failed passwords —
# a default-deny rule on the firewall side hides legitimate root usage.
# Default: max(1, ssh_fail_threshold // 2). With ssh_fail_threshold = 3
# this works out to 1 = instant block on first 'Failed password for root'.
# Set to 0 to disable the dedicated root rule (root attempts then count
# against the regular ssh_fail_threshold).
# (v1.5+)
ssh_root_fail_threshold = 1

# Roundcube webmail failed-login threshold (v1.4+)
roundcube_fail_threshold = 10

[escalation]
# Tier 1: first offense
tier1_duration = 24h

# Tier 2: repeat offender (returns within tier2_lookback after tier1 expires)
tier2_duration = 30d
tier2_lookback = 7d

# Tier 3: persistent threat
tier3_permanent = true

# Block expiry reaper (v1.7.9+)
# Nothing enforced the durations above before this. Every hour the daemon
# unblocks tier-1/tier-2 IPs whose duration has elapsed and resets their tier
# so a returning attacker escalates normally. Tier 3 is never expired.
#
# Turning this off restores the old behavior, which differed by backend:
#   firewalld            — blocks were permanent (ipsets carry no TTL)
#   mikrotik/nftables/csf — the firewall dropped the entry on its own TTL, but
#                           the stale tier stopped the IP being re-blocked
reap_enabled = true

# Max IPs to expire per hourly sweep. 500/hour = 12,000/day.
#
# Only really matters on firewalld and pfSense, where every expiry is a
# firewall call (two on firewalld: runtime + permanent), so a large backlog is
# drained gradually rather than in one burst.
#
# On mikrotik, nftables and csf the firewall expires entries on its own TTL,
# so the sweep just clears the stale tier in the database and issues no
# firewall calls at all — raise this freely there.
reap_batch_limit = 500

[cidr]
# CIDR /24 aggregation — auto-block entire subnet when enough IPs are blocked
enabled = true
# How many unique blocked IPs in a /24 before blocking the whole range
threshold = 5
# Duration for CIDR blocks (30d recommended, 'permanent' for aggressive mode)
duration = 30d

[firewall]
# Which firewall backend to use:
#   csf       = ConfigServer Firewall (blocks on this server)
#   firewalld = firewalld — default on RHEL/AlmaLinux/CyberPanel 2.4+
#   nftables  = nftables directly (modern Linux without firewalld)
#   mikrotik  = MikroTik RouterOS (blocks at network edge via SSH)
#   pfsense   = pfSense (blocks at network edge via REST API)
#   opnsense  = OPNsense (blocks at network edge via REST API)
# See backends/README.md for adding custom backends
backend = csf

# flush_conntrack: for the firewalld and nftables backends only.
# firewalld accepts already-established connections before the block rule is
# evaluated, so blocking an IP only stops NEW connections — an attacker holding
# HTTP keep-alive connections open keeps flooding until they close. When true,
# Guardian runs `conntrack -D -s <ip>` right after blocking, tearing down the
# live connections so the block takes effect in under a second.
# Requires the conntrack CLI:  dnf install conntrack-tools  (RHEL/AlmaLinux)
# or  apt install conntrack  (Debian/Ubuntu). Safe no-op if not installed
# (Guardian warns at startup). Ignored by csf/mikrotik/pfsense backends.
flush_conntrack = true

[mikrotik]
# Only used when [firewall] backend = mikrotik
host = 192.168.2.1
port = 22
user = guardian
key_file = /root/.ssh/mikrotik_guardian

# Address list names on MikroTik
list_tier1 = wp-block-24h
list_tier2 = wp-block-30d
list_tier3 = wp-block-permanent
list_cidr = wp-block-cidr

# Existing friendly list to check (never block these)
friendly_list = friendly

[csf]
# CSF-specific settings (currently uses defaults)
# CSF reads its allow/deny lists from /etc/csf/

[firewalld]
# Only used when [firewall] backend = firewalld
# zone: firewalld zone to add rules to (default: public)
zone = public

[nftables]
# Only used when [firewall] backend = nftables
# priority: chain priority (lower = evaluated earlier, default: -10)
priority = -10

[pfsense]
# Used when [firewall] backend = pfsense or opnsense
# host: IP or hostname of the firewall
host = 192.168.1.1
port = 443
# API credentials (create in System > User Manager > API Keys)
api_key =
api_secret =
# Platform: pfsense or opnsense (auto-detect if empty)
platform =
# SSL verification (set to true if using a valid cert)
verify_ssl = false
# Alias names on the firewall (must create these manually first)
# Create a Host alias for individual IPs and a Network alias for CIDRs
# Then add a firewall rule to block traffic from both aliases
alias_name = wp_guardian_blocked
alias_cidr = wp_guardian_cidr

[whitelist]
# Path to whitelist file (one IP or CIDR per line, # for comments)
file = /opt/wp-guardian/whitelist.conf

# Legitimate PHP endpoints, exempt from the "suspicious PHP scanning" rule
# (v1.7.10+). That rule matches ANY lowercase .php filename of 6+ letters, so
# an ordinary application endpoint — /billing.php, /account.php, /support.php,
# /profile.php — otherwise counts as a scan. Comma-separated, leading slash,
# lowercase. Added to the built-in set (/api.php, /ajax.php, /public.php,
# /cron.php, /rss.php, /feed.php, /client.php, /index.php), never replaces it.
# legit_php_paths = /billing.php, /account.php

# Extra build-tool path prefixes exempted from the general 404-storm count
# and charged to the looser framework bucket instead (v1.7.16+). Only needed
# for a framework modules/spa_assets.py does not already know. Prefixes, not
# globs; .php paths are never eligible whatever is listed here.
# framework_payload_paths = /_myapp/, /__build/

[geoip]
# MaxMind GeoLite2 databases (v1.4+)
# Enable to geo-enrich auth events and feed DistributedAuthDetector.
# You must download GeoLite2-City.mmdb and GeoLite2-ASN.mmdb from MaxMind
# (free registration required). See INSTALL.md for setup instructions.
enabled = false

# Paths to the .mmdb files
city_database_path = /opt/wp-guardian/state/geoip/GeoLite2-City.mmdb
asn_database_path = /opt/wp-guardian/state/geoip/GeoLite2-ASN.mmdb

# LRU cache size (IPs kept in memory). 0 = no cache.
cache_size = 10000

# What to do if a database file is missing at startup.
#   fail = refuse to start
#   warn = log warning, continue with geoip disabled at runtime
on_missing_db = warn

# Baseline retention (days) — reserved for future geo baseline work
baseline_retention = 90

[telegram]
# Telegram bot alerts — run --telegram-setup to configure
enabled = false
bot_token =
chat_id =

# Rate limiting
max_alerts_per_minute = 10

# Interactive commands via Telegram (receive commands, not just send alerts)
# Requires bot_token and chat_id to be configured
# SECURITY: Only messages from the configured chat_id are processed
commands_enabled = false
# Long-poll timeout in seconds (how long to wait for new messages)
commands_poll_timeout = 30

# Alert mode (v1.4+):
#   verbose = every block alerts immediately (v1.3 behavior; default for first week of tuning)
#   digest  = tier-1/tier-2 routine blocks are buffered into an hourly digest message;
#             compromise, tier-3, CIDR /24 and BLOCK FAILED stay immediate
#   quiet   = only compromise and BLOCK FAILED alert immediately; everything else digested
alert_mode = verbose

# Digest flush interval (seconds)
digest_interval = 3600

# Maximum events per digest message
digest_max_events = 50

# Quiet hours (don't send low-priority alerts)
# Format: HH:MM-HH:MM in server local time
# quiet_hours = 23:00-07:00

[telegram.rules]
# Per-rule routing (v1.4.1+). Values: immediate | digest | silent
#
# Overrides [telegram] alert_mode for specific detection rules.
# Unlisted rules fall back to hardcoded defaults (below), then to alert_mode.
# You can also tune this live from Telegram: /verbosity <rule> <level>
#
# Always-immediate (cannot be muted, regardless of setting):
#   compromise, cidr, block_failed, and any tier-3 block
#
# Hardcoded defaults:
#   Web      — wp_login, xmlrpc, tripwire, instant, structural, suspicious,
#              login_isolation       → immediate
#              php_scan, general_404, author_enum  → silent
#   Mail     — smtp_fail, imap_fail, pop3_fail, roundcube  → immediate
#   SSH      — ssh_fail, ssh_invalid                        → immediate
#   Meta     — trusted_skip (mail-client heads-up)          → immediate
#
# Example — digest noisy web detections, mute ssh brute force:
# php_scan = digest
# general_404 = digest
# ssh_fail = silent

[auth_tracking]
# How long a successful WordPress login grants "trusted" status (hours).
# Trusted IPs bypass WordPress tripwires and login isolation.
wp_trust_duration = 24

# How long a successful mail login (IMAP/POP3/SMTP) grants "trusted" status (hours).
# Trusted IPs are exempt from SMTP/IMAP/POP3/Roundcube auth-failure thresholds —
# a legitimate mail client with a wrong outgoing password won't get its
# working IMAP connection killed. DistributedAuthDetector still catches
# real credential compromise (same account from many countries/ASNs).
mail_trust_duration = 24

[log_paths]
# Override auto-detected log paths if needed
# mail_log = /var/log/maillog
# secure_log = /var/log/secure
# roundcube_log = /var/www/roundcube/logs/errors.log

[database]
path = /opt/wp-guardian/state/guardian.db

# Data retention
auth_retention_days = 90
ip_history_retention_days = 180

# Outbound send records (v1.7.15+). Shorter than auth_sessions on purpose:
# this table grows per MESSAGE rather than per login, and its only consumer is
# a baseline that looks back outbound_baseline_days. Setting it below that
# value silently truncates the baseline — Guardian warns at startup if you do.
outbound_retention_days = 30

[log_analysis]
# Automated log discovery and tripwire analysis
# When enabled, runs periodically inside the daemon

# Auto-discover new access log files
auto_discover = false
discover_interval = 24h

# Auto-analysis removed — use --analyze-tripwires for manual review
# See: python3 wp-guardian.py --analyze-tripwires

# ---------------------------------------------------------------------------
# v1.4 — Compromise detection, mail backend, profile
# ---------------------------------------------------------------------------

[profile]
# Threshold profile mode.
#   steady    = tight thresholds for normal operations
#   migration = loose thresholds for post-cutover periods when legitimate
#               users are fat-fingering credentials during a migration
mode = steady

[compromise_detection]
# DistributedAuthDetector — fires when a single account authenticates from
# N+ distinct countries / ASNs / IPs in a short window. This catches
# credential compromise used by distributed credential-abuse botnets.
#
# Requires [geoip] enabled = true for the country and ASN rules to work.
enabled = false

# Sliding window in seconds (default 3600 = 1 hour)
window_seconds = 3600

# Fire when ANY of these thresholds are hit.
#
# Recalibrated in v1.7.11. The previous defaults (3 countries / 5 ASNs) sat on
# the noise floor: across six lifetime events on the reference host, all five
# false positives landed on their threshold EXACTLY and never one above, while
# the only genuine compromise cleared it by roughly an order of magnitude
# (28 countries, 39 ASNs, 62 IPs). A wide empty region separates the two
# populations; these values sit inside it.
#
# Raise them further if you host users who legitimately roam a lot. Lowering
# them back toward 3/5 reintroduces the false positives — a multi-homed user
# with two fixed lines and a phone routinely reaches 4-5 ASNs in an hour.
threshold_distinct_countries = 6
threshold_distinct_asns = 10
threshold_distinct_ips = 20

# What to do on detection:
#   alert_only       — record event + Telegram alert, nothing else
#   block_ips        — alert + block all attacker IPs seen in the window
#   disable_mailbox  — alert + disable mailbox in the mail backend
#   full             — alert + block IPs + disable mailbox (default)
action = full

# Per-rule enforcement (v1.7.11+). Overrides `action` for one trigger rule;
# omit a key to inherit `action`.
#
# The three rules are not equally trustworthy. `countries` caught the only
# real compromise on record. `asns` has fired twice and been wrong twice —
# both times at exactly 5 of 5 ASNs inside a SINGLE country, which is what a
# US consumer user looks like when their phone roams between carrier pools.
# One country cannot corroborate a distributed-abuse story, so an ASN-only
# trigger alerts and leaves both the mailbox and the client's IPs alone.
#
# Note this also governs IP blocking: under alert_only the source IPs are NOT
# firewall-blocked. In the 2026-08-09 false positive five of the client's own
# addresses were dropped alongside his mailbox.
#
# If you remove these keys entirely, `asns` still defaults to alert_only in
# code. Set action_asns = full explicitly to override that.
action_countries = full
action_asns = alert_only
action_ips = full

# ---------------------------------------------------------------------------
# Abuse corroboration (v1.7.12+)
# ---------------------------------------------------------------------------
# Geography selects candidates; abuse evidence authorises enforcement.
#
# The detector answers "is this account authenticating from an implausible
# spread of networks". These checks answer the separate question "is there any
# sign it is actually being MISUSED" — and where a rule is muted on geography
# alone, real evidence promotes it back up to corroborated_action.
#
# Signals are matched to how a takeover actually unfolds. Credentials are
# stolen, the attacker logs in, reads mail, plants persistence, and monetises
# days or weeks later. Checking only for outbound spam would stay silent
# through the whole window where intervention is cheap, so these look for the
# reconnaissance-phase artefacts instead:
#
#   auth-failure burst   credential stuffing leaves a pile of failures
#                        immediately before the success that matters
#   sieve injection      a mailbox filter planted over ManageSieve, which
#                        accepts nothing but the stolen IMAP password
#   alias injection      a forwarding row planted in the mail database
#
# Requires [mail_backend] maildir_template for the sieve check and
# alias_table for the forwarding check. Missing either just drops that one
# signal — nothing errors.
corroboration_enabled = true

# Enforcement once abuse is corroborated. An account on 5 ASNs is a
# travelling client; an account on 5 ASNs with a sieve rule planted yesterday
# is a takeover. Promotion only ever moves enforcement UP.
corroborated_action = full

# How far back a persistence artefact still counts, in hours. Much wider than
# the detector's 1h window on purpose: the sieve rule was planted during a
# dwell phase that may predate the geographic trigger by days.
corroboration_lookback_hours = 168

# Failed auths for one ACCOUNT (across all source IPs) that count as a
# stuffing burst. Distinct from the per-IP brute-force thresholds — stuffing
# arrives from many addresses by design, so a per-IP counter never sees it.
corroboration_failure_threshold = 20
corroboration_failure_window = 3600

# ---------------------------------------------------------------------------
# Outbound corroboration — the payload phase (v1.7.15+)
# ---------------------------------------------------------------------------
# The checks above look for what an attacker does while getting established.
# These two look at what the account actually SENT, which is harder proof but
# arrives later in the takeover.
#
# Records one row per authenticated outbound message, correlating Postfix's
# authenticated smtpd line with the qmgr line that carries the size and
# recipient count. The queue ID is the join key, and the join is mandatory:
# qmgr logs inbound and outbound mail identically, so counting it alone would
# measure how much mail arrives FOR an account and call it sending.
#
# Set to false to stop recording entirely (the table is then never written).
outbound_monitoring = true

# How far back "recent sending" reaches, in hours. Wider than the detector's
# 1h window because the burst and the geographic anomaly need not be
# simultaneous — sending may start an hour before the login that trips the
# country count, or the other way round.
outbound_window_hours = 6

# The account's own normal rate is computed over this many days, excluding the
# recent window (so a burst cannot inflate the bar it is measured against).
outbound_baseline_days = 30

# THE VOLUME CHECK IS INERT UNTIL THE TABLE HOLDS THIS MUCH HISTORY, measured
# across all accounts rather than one. On a fresh install every account looks
# anomalous because there is nothing to compare against, and this check can
# promote enforcement as far as disabling a mailbox. Expect roughly two weeks
# after upgrading before it does anything at all — `--outbound-stats` shows
# how much has accrued. The fan-out check below is armed immediately and
# covers that gap.
outbound_min_observation_days = 14

# Both of these must be cleared for a volume signal. The floor is the
# load-bearing one: a multiplier against a near-zero baseline is a division by
# almost nothing, and would fire on a mailbox going from one message a week to
# three.
outbound_volume_floor = 100
outbound_volume_multiplier = 10

# Recipients on a SINGLE message (Postfix's nrcpt). Needs no history, so this
# is the one outbound signal that works on the day you install it.
#
# 250 is calibrated against 4.5 weeks of a real small-business mail host: every
# message there had 9 recipients or fewer, except one legitimate newsletter at
# 133. An earlier default of 50 would have fired on that newsletter — and on
# the worst possible mailbox, because the one account that sends bulk was also
# the one that roams across the most networks. Those two risks land on the same
# client rather than being independent, which is what makes a low threshold
# here expensive.
#
# Set to 0 to disable the check. That is the right choice if your users send
# bulk mail from their own mailboxes: the volume check above is immune to it,
# since volume counts MESSAGES and a newsletter is one message however many
# recipients it carries.
#
# Check your own numbers before raising it:
#   python3 wp-guardian.py --outbound-stats --days 30
outbound_fanout_threshold = 250

# How long a submission waits for its qmgr line, in seconds, and the hard cap
# on unmatched submissions held in memory. Only worth touching if the log
# shows the pending map hitting its cap.
outbound_queue_ttl = 300
outbound_max_pending = 10000

# The inverse gate: refuse to disable a mailbox WITHOUT abuse evidence, even
# when the rule says full.
#
# Off by default, deliberately. It would weaken `countries` — the one rule
# that has ever been right — and six or more countries in an hour is close to
# impossible legitimately. Turn it on if you would rather never auto-disable
# on geography alone and accept catching a real compromise later.
require_corroboration = false

# Provisional disables (v1.7.11+).
#
# Hours a compromise mailbox-disable stands before Guardian reverses it
# automatically. Absent operator confirmation the disable is treated as
# PROVISIONAL, which bounds the cost of a detection error — including error
# classes nobody has predicted. The 2026-08-09 false positive ran 16h04m
# because the alert arrived at 23:44 and the operator was asleep; the client
# only escaped a full night of dead mail because his device happened not to
# poll overnight.
#
# This is safe because reversal does NOT restore the attacker's access: the
# source IPs stay firewall-blocked on the normal tier schedule (24h minimum),
# so anyone benefiting would need entirely fresh infrastructure. What comes
# back is the account, for its owner.
#
# /confirm <event_id> pins a disable permanently — before the window elapses,
# or after (it re-disables). 0 disables the reversal entirely, restoring the
# pre-v1.7.11 behaviour of "disabled until a human notices".
auto_reenable_hours = 4

# Max mailboxes restored per hourly sweep. Compromise events are rare; this
# exists only so a pathological backlog cannot fire hundreds of mail-backend
# writes in one tick.
auto_reenable_batch_limit = 50

# Anti-spam: don't re-fire for the same username within this many seconds
suppression_seconds = 1800

# Exclude usernames matching any of these regex patterns (one per line).
# Useful for known-mobile users or shared service accounts.
exclude_usernames =

# Trusted ASNs — comma-separated list of ASNs whose rows are NOT counted
# toward the country and ASN thresholds. Cloud mail providers (Microsoft 365,
# Google Workspace, Apple iCloud) relay outbound traffic from many DCs in
# different countries for the same legitimate user, which would otherwise
# look exactly like distributed credential abuse. The IP-count threshold
# is unaffected by this list — a real volumetric attack via a trusted ASN
# will still trip threshold_distinct_ips.
#
# Defaults below cover the common false-positive sources:
#   8075   = Microsoft (Office 365 / Exchange Online / Outlook.com)
#   15169  = Google (Gmail / Workspace)
#   714    = Apple (iCloud Mail)
trusted_asns = 8075, 15169, 714

# Services for which trusted_asns ALSO exempts from blocking, not just from
# counting as evidence (v1.7.9+).
#
# Before this existed the two halves disagreed: a Microsoft relay was too
# trusted to count as proof of compromise, then got firewall-dropped as the
# attacker anyway. Since new Outlook syncs IMAP through Microsoft's cloud
# rather than from the PC, that silently killed the client's mail — and
# whitelisting the IP is whack-a-mole because Microsoft rotates them.
#
# Scoped to mail services on purpose. AS8075 is Office 365 *and* Azure, and
# an Azure VM scanning wp-login.php should still be blocked — leave web and
# ssh off this list. Set empty to disable the exemption entirely.
trusted_asn_services = smtp, imap, pop3, roundcube

# ---------------------------------------------------------------------------
# v1.5 — CMS auto-detect & POST-flood
# ---------------------------------------------------------------------------

[cms_detection]
# Build an in-memory map of {site -> CMS} at startup so per-CMS detectors
# (and the POST-flood watchlist) know what's running on each vhost.
#
# Detection: walks logfiles_list, derives site names from /home/<site>/logs/
# paths, and fingerprints each docroot (wp-config.php = WordPress, etc.).
# Sites that can't be fingerprinted are recorded as 'unknown' and only get
# the universal web rules — no harm done.
enabled = true

# How often to re-detect (seconds). Useful when new sites are provisioned.
refresh_interval = 21600

# Per-vhost overrides — INI file, optional. Format:
#   [example.com]
#   cms = joomla
#   admin_paths = /sekret-admin/index.php, /administrator/index.php
#   post_flood_threshold = 50
# Operator only edits this when auto-detect is wrong or to declare a renamed
# admin path. Empty / missing file = pure auto-detect.
vhosts_overrides = /opt/wp-guardian/vhosts.conf

[post_flood]
# Generic POST-flood detector (v1.5). Watchlist-only — only paths registered
# by a CMS module (or vhosts.conf) get watched, plus the universal_paths list
# below. WordPress wp-login.php is NOT watched here because the dedicated
# wp_login rule already covers it.
#
# Two-stage gate to minimize FPs on offices behind shared NAT:
#   Stage 1: threshold POSTs to one URL from one IP within window
#   Stage 2: at least one behavioral signal — no CSS loads, off-host Referer,
#            or identical Content-Length across recent POSTs.
#
# Trusted IPs (recently authenticated on any service) bypass the detector.
enabled = false

# Stage 1 — rate gate
threshold = 30
window = 300

# Stage 2 — behavioral confirmation
# Set to false to disable behavioral checks (NOT recommended; will FP heavily
# behind office NAT or on busy contact forms).
behavioral_required = true
behavioral_referer_pct = 80
behavioral_content_length_pct = 80

# Universal paths watched on every vhost regardless of CMS. Comma-separated;
# extends the built-in defaults (/phpmyadmin/, /cpanel, /login, /signin,
# /admin/login, /admin/index.php).
universal_paths =

[mail_backend]
# Integration with the mail server's MariaDB, so CompromiseAction
# can disable compromised mailboxes automatically.
#
# Supported types (recipes):
#   none         — disabled (default)
#   cyberpanel   — CyberPanel (locks account by resetting password)
#   postfixadmin — Postfixadmin (toggles active column)
#   mailcow      — Mailcow (toggles active column)
#   iredmail     — iRedMail (toggles active column)
#   custom       — manual config (you specify table/column names)
#
# Each recipe auto-fills database, table, and column names.
# You can override any recipe default by setting it explicitly below.
#
# Disable strategy:
#   toggle_enabled  — SET enabled=0/1 (postfixadmin, mailcow, iredmail, custom)
#   password_reset  — scramble password to lock, restore to unlock (cyberpanel)
#
# Operator must create a least-privilege MariaDB user ahead of time.
#
# For toggle_enabled recipes:
#   GRANT SELECT (email, enabled), UPDATE (enabled)
#     ON <database>.<table> TO 'wp_guardian'@'localhost';
#
# For password_reset recipes (cyberpanel):
#   GRANT SELECT (email, password), UPDATE (password)
#     ON cyberpanel.e_users TO 'wp_guardian'@'localhost';
#
# ---------------------------------------------------------------------------
# OPTIONAL — alias / forwarding table (read-only)
# ---------------------------------------------------------------------------
# Guardian can read your alias table to detect a forwarding rule planted on a
# compromised mailbox. Mailbox-rule injection is the standard BEC follow-on
# and happens during the attacker's reconnaissance phase — typically days
# before any spam is sent — which makes it far stronger evidence than
# outbound volume alone.
#
# There is NO standard schema for this across mail stacks. Check yours with
# `SHOW TABLES FROM <database>` and `DESCRIBE <table>` before configuring.
# Layouts seen in the wild:
#
#   postfix+dovecot MySQL   virtual_aliases (source, destination, created_at)
#   postfixadmin / mailcow  alias           (address, goto)
#   iRedMail                forwardings     (address, forwarding)
#
# EASIEST WAY TO FILL THESE IN — let Guardian read your Postfix and Dovecot
# config and tell you what your schema is:
#
#   python3 /opt/wp-guardian/wp-guardian.py --detect-mail-schema
#
# It prints the settings below with the file each one came from, plus the
# exact GRANT statement. It reads config files only, so it needs no database
# credentials, and it changes nothing — you copy across what you agree with.
#
# Leave alias_table empty and Guardian skips the check entirely; the feature
# is optional and its absence just means one fewer corroborating signal.
#
# A created/timestamp column is optional but valuable: with it Guardian can
# tell a rule planted an hour ago from one the client has had for two years.
# Without it, only presence is checked.
alias_table =
alias_source_column =
alias_destination_column =
alias_created_column =

# Where Dovecot keeps maildirs, used by the sieve-injection check to find
# ~/.dovecot.sieve. Placeholders are {domain} {user} {email}.
#
# NOTE this is deliberately NOT Dovecot's own %d/%n syntax. Python's
# ConfigParser performs interpolation on %, so a literal % anywhere in this
# file makes the daemon fail to start. --detect-mail-schema translates
# Dovecot's mail_location into the brace form for you.
#
# Example: mail_location = maildir:/var/vmail/%d/%n
#       -> maildir_template = /var/vmail/{domain}/{user}
maildir_template =
#
# Grant SELECT on exactly those columns, nothing more:
#   GRANT SELECT (<source>, <destination>, <created>)
#     ON <database>.<alias_table> TO 'wp_guardian'@'localhost';
#
# Guardian NEVER needs UPDATE or DELETE here. It reads forwarding rules to
# spot tampering; it does not modify mail routing. If your DB user already
# holds write access on this table, revoke it.
type = none
host = 127.0.0.1
port = 3306
user = wp_guardian
password =
# Override recipe defaults if your setup differs:
# database = mailserver
# table = virtual_users
# email_column = email
# enabled_column = enabled
# password_column = password

[posture]
# Posture-audit + host-health module (task #122).
#
# Runs a daily set of read-only checks for security drift (file perms,
# kernel/polkit versions, listening ports, multi-tenant isolation) and
# system-health drift (SMART, disk, worker saturation, etc.). Each check
# declares its own applicability against the auto-detected host profile,
# so a free single-site install on a plain VPS only runs the generic
# Linux checks; a multi-tenant CL+Apache box gets the full set.

# Enable/disable the whole subsystem.
enabled = true

# How often the orchestrator runs (seconds). 86400 = daily.
interval_seconds = 86400

# Severity floor for Telegram alerts on transitions.
# One of: info | low | medium | high | critical
# Recommendation: 'high' (default) — keeps the chat quiet while still
# paging on the things that actually matter.
alert_severity_min = high

# Whether transitions BACK to PASS should fire Telegram alerts.
# Default false: once the original FAIL alert has been delivered, you
# don't need a recovery ping — current state is visible via
# --posture-status / --posture-events. Set true if you specifically
# want resolution-confirmed messages (e.g. on hosts where you actively
# repair things and want a Telegram nudge that the fix took effect).
alert_on_recovery = false

# How long to keep posture_events rows. Older rows are pruned daily.
events_retention_days = 30

# How often to re-detect the host profile (seconds). The profile changes
# rarely — distro upgrades, cluster role changes, perimeter rewiring —
# so daily re-detection is plenty.
profile_refresh_seconds = 86400

# Profile overrides. Leave commented for auto-detect; uncomment to force.
#
# behind_perimeter_firewall = true
#   Set true on hosts whose listening ports are not directly internet-
#   reachable (e.g. behind a MikroTik, AWS SG, Cloudflare Tunnel).
#   Affects severity of port-binding and sshd-config checks: a non-localhost
#   bind on a perimeter-protected box is informational, on an exposed box
#   it's medium severity.
# behind_perimeter_firewall = auto
#
# is_multi_tenant = true
#   Auto-detect counts /home tenant directories with public_html / web /
#   logs subdirs. Override if your layout is non-standard.
# is_multi_tenant = auto

[tmp_cleanup]
# Active /tmp janitor (task #122 Part D — companion to the read-only
# `tmp_hygiene` posture check). v1.6.1 expanded the module to handle
# directories, dropped the world-readable mode bit requirement (it
# excluded legitimate operator scratch like *.bak.* files at 0750),
# added an always-wins SYSTEM excludelist for live system state
# (/tmp/lshttpd, /tmp/systemd-private-*, X11 sockets, DB unix sockets,
# etc.), and added top-N-by-size reporting to the digest.
#
# A path is a cleanup candidate only when ALL of these match:
#   * top-level entry of /tmp (no recursion at the candidate level)
#   * basename does NOT match the SYSTEM excludelist (always denies,
#     higher precedence than allowlist)
#   * is NOT itself a mountpoint (defends against systemd PrivateTmp)
#   * realpath strictly under /tmp/ (no symlink escape)
#   * owner uid 0 (root)
#   * mtime older than `age_days`
#   * basename matches one of `allowlist_patterns`
#   * file/dir is not currently held open (lsof)
# For directories, the recursive walker additionally requires every
# contained file to be uid 0, every symlink to point inside /tmp, and
# no subdir to be a mountpoint.
#
# Default mode = off. Recommended rollout: enable as `dry_run`, watch
# the daily Telegram digest for ~14 days, then promote to `live`.

# off | dry_run | live
# off:     module disabled (default — opt-in only).
# dry_run: scan + log + Telegram digest reports what WOULD be deleted.
# live:    same as dry_run, plus actually deletes each candidate.
mode = off

# Files older than this many days are eligible for cleanup.
age_days = 7

# How often the cleanup runs (seconds). 86400 = daily.
interval_seconds = 86400

# v1.6.1: include directories as candidates. Operator-dropped scratch
# (claude-*, *-fresh, restore-*, new-vhosts, node-compile-cache) is
# almost always directories; turning this off reverts to the v1.6.0
# files-only behavior for a more conservative posture.
include_directories = true

# Comma-separated glob patterns matched against entry basenames. A path
# is only deleted if its name matches at least one pattern AND every
# other criterion above. v1.6.1 expanded the defaults to cover the
# operator scratch we observed in production (timestamped *.bak.*
# files, *-fresh extract dirs, restore-* dirs, language compile caches,
# Python multiprocessing leftovers).
allowlist_patterns = *.log, *.bak.*, *.backup.*, body-*, curl-*, *-init.log, claude-*, tmp-*.log, last_resp.json, build-manual-*.log, *-fresh, restore-*, staging-*, new-vhosts, node-compile-cache, python-compile-cache, pip-*-build, pip-tmp-*, pip-build-*, pymp-*, cagefs-init.log

# v1.6.1: hardcoded SYSTEM excludelist always applies (lshttpd*,
# systemd-private-*, .X11-unix, .ICE-unix, .font-unix, .XIM-unix,
# tmux-*, mysql.sock, .s.PGSQL.*, .crontab.lock, cagefs.sock, snap-private-*).
# Use this option to ADD additional patterns to deny on this host —
# you cannot make the list shorter than the safe baseline.
additional_excludes =
